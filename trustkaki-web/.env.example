# TrustKaki AI Lodge demo. The API (server/, Cloud Run) reads these; copy to .env for
# `npm run dev:server`. Do not commit real values. The Next.js frontend (Vercel) needs only
# NEXT_PUBLIC_API_BASE.

# ── Inference (OpenAI-compatible gateway; the club runs on apiyi) ──
API_BASE_URL=https://api.apiyi.com/v1
API_KEY=
# Every agent (triage, digital safety, context memory, community activities, briefing).
MODEL_NAME=deepseek-v4-flash
# Per model call, in ms; the agents share a 45 s budget per message.
TRUSTKAKI_LLM_TIMEOUT_MS=30000

# ── CORS: the Vercel frontend origin(s), comma-separated ──
CORS_ORIGINS=http://localhost:3000

# ── Shared AI Lodge rate limiter (Upstash Redis). Unset = no limit (local dev) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallbacks; the central control sheet overrides them. One hit per message sent to the agents.
RATE_LIMIT_CHAT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# ── Optional: Jev specialist routing (OpenRouter's System One endpoint; off in the demo) ──
TRUSTKAKI_JEV_ENABLED=false
TRUSTKAKI_JEV_ROUTING_SHADOW_ENABLED=false
TRUSTKAKI_JEV_ROUTING_ENABLED=false
JEV_API_BASE_URL=https://openrouter.ai/api/v1
JEV_API_KEY=

# ── Frontend (Vercel): the Cloud Run URL of the API ──
NEXT_PUBLIC_API_BASE=http://localhost:8080
